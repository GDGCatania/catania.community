{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "~/*": ["src/*"],
      "@ingest/*": ["tools/ingest/*"]
    },
    "types": ["astro/client", "node"],
    "verbatimModuleSyntax": true
  },
  "include": [".astro/types.d.ts", "src/**/*", "tools/**/*", "*.mjs", "*.ts"],
  "exclude": ["dist", "node_modules", "apps/submit-worker", "src/paraglide"]
}
