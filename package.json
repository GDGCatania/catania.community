{
  "name": "catania.community",
  "version": "0.1.0",
  "description": "Agenda unificata degli eventi delle community di Catania e provincia",
  "license": "AGPL-3.0-or-later",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "npm run paraglide && astro check",
    "ingest": "tsx tools/ingest/index.ts",
    "validate": "tsx tools/validate.ts",
    "test": "npm run paraglide && vitest run",
    "test:watch": "vitest",
    "paraglide": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "astro": "^7.1.4",
    "leaflet": "^1.9.4",
    "node-ical": "^0.27.1",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@inlang/paraglide-js": "^2.24.1",
    "@inlang/plugin-m-function-matcher": "^2.2.11",
    "@inlang/plugin-message-format": "^4.4.3",
    "@types/leaflet": "^1.9.17",
    "@types/node": "^22.14.1",
    "tsx": "^4.23.1",
    "typescript": "~5.9.3",
    "vitest": "^4.1.10"
  }
}
