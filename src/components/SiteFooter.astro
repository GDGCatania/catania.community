---
import { t } from '../i18n';
import { REPO_URL, ROUTES } from '../lib/site';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container inner">
    <div class="col">
      <p class="eyebrow">catania.community</p>
      <p class="note">{t('footer.about')}</p>
    </div>

    <div class="col">
      <p class="eyebrow">{t('footer.openFormats')}</p>
      <ul>
        <li><a href={ROUTES.feedIcs}>{t('footer.calendar')}</a></li>
        <li><a href={ROUTES.feedRss}>{t('footer.rss')}</a></li>
        <li><a href={ROUTES.feedJson}>{t('footer.json')}</a></li>
      </ul>
    </div>

    <div class="col">
      <p class="eyebrow">{t('footer.contribute')}</p>
      <ul>
        <li><a href={ROUTES.submit}>{t('footer.addCommunity')}</a></li>
        <li><a href={`${REPO_URL}/issues`}>{t('footer.reportError')}</a></li>
        <li><a href={REPO_URL}>{t('footer.sourceCode')}</a></li>
      </ul>
    </div>

    <div class="col">
      <p class="eyebrow">{t('footer.licenses')}</p>
      {/* Built from separate keys rather than splitting one sentence: word
          order around the links differs between languages. The explicit spaces
          matter too — since Astro 7 `compressHTML` follows JSX rules and eats
          the whitespace at the end of a line. */}
      <p class="note">
        {t('footer.licenseCode')}{' '}
        <a href={`${REPO_URL}/blob/main/LICENSE`}>AGPL-3.0</a>,{' '}
        <a href={`${REPO_URL}/blob/main/LICENSE-DATA`}>{t('footer.dataLicense')}</a>.{' '}
        {t('footer.licenseMapsPrefix')}{' '}
        <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>{t('footer.licenseMapsSuffix')}.
      </p>
    </div>
  </div>

  <div class="container bottom">
    <span class="mono">{year} · {t('footer.madeIn')}</span>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--space-8);
    border-top: 1px solid var(--border);
    background: var(--surface);
    padding-block: var(--space-6) var(--space-5);
  }

  .inner {
    display: grid;
    grid-template-columns: 1.6fr 1fr 1fr 1.2fr;
    gap: var(--space-6);
    align-items: start;
  }

  .col > .eyebrow {
    margin-bottom: var(--space-3);
  }

  .note {
    font-size: var(--step--1);
    line-height: 1.6;
    color: var(--ink-2);
  }

  ul {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  li a {
    font-size: var(--step--1);
    color: var(--ink-2);
  }

  li a:hover {
    color: var(--accent);
  }

  .bottom {
    margin-top: var(--space-6);
    padding-top: var(--space-4);
    border-top: 1px solid var(--border-soft);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  @media (max-width: 860px) {
    .inner {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-5);
    }
  }

  @media (max-width: 520px) {
    .inner {
      grid-template-columns: 1fr;
    }
  }
</style>
