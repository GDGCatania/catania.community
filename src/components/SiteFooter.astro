---
import * as m from '../paraglide/messages.js';
import Message from './Message.astro';
import { REPO_URL, ROUTES, SITE_NAME, FOOTER_ABOUT } from '../lib/site';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container inner">
    <div class="col">
      <p class="eyebrow">{SITE_NAME}</p>
      <p class="note">{FOOTER_ABOUT}</p>
    </div>

    <div class="col">
      <p class="eyebrow">{m.footer_openFormats()}</p>
      <ul>
        <li><a href={ROUTES.feedIcs}>{m.footer_calendar()}</a></li>
        <li><a href={ROUTES.feedRss}>{m.footer_rss()}</a></li>
        <li><a href={ROUTES.feedJson}>{m.footer_json()}</a></li>
      </ul>
    </div>

    <div class="col">
      <p class="eyebrow">{m.footer_contribute()}</p>
      <ul>
        <li><a href={ROUTES.submit}>{m.footer_addCommunity()}</a></li>
        <li><a href={`${REPO_URL}/issues`}>{m.footer_reportError()}</a></li>
        <li><a href={REPO_URL}>{m.footer_sourceCode()}</a></li>
      </ul>
    </div>

    <div class="col">
      <p class="eyebrow">{m.footer_licenses()}</p>
      {/* One whole sentence with the links inside it, so a translator can move
          them: Italian says "Mappe © collaboratori OpenStreetMap", English
          "Maps © OpenStreetMap contributors". */}
      <p class="note">
        <Message
          of={m.footer_license}
          links={{
            code: `${REPO_URL}/blob/main/LICENSE`,
            data: `${REPO_URL}/blob/main/LICENSE-DATA`,
            osm: 'https://www.openstreetmap.org/copyright',
          }}
        />
      </p>
    </div>
  </div>

  <div class="container bottom">
    <span class="mono">{year} · {m.footer_madeIn()}</span>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--space-8);
    border-top: 1px solid var(--border);
    background: var(--surface);
    padding-block: var(--space-6) var(--space-5);
  }

  .inner {
    display: grid;
    grid-template-columns: 1.6fr 1fr 1fr 1.2fr;
    gap: var(--space-6);
    align-items: start;
  }

  .col > .eyebrow {
    margin-bottom: var(--space-3);
  }

  .note {
    font-size: var(--step--1);
    line-height: 1.6;
    color: var(--ink-2);
  }

  ul {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  li a {
    font-size: var(--step--1);
    color: var(--ink-2);
  }

  li a:hover {
    color: var(--accent);
  }

  .bottom {
    margin-top: var(--space-6);
    padding-top: var(--space-4);
    border-top: 1px solid var(--border-soft);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  @media (max-width: 860px) {
    .inner {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-5);
    }
  }

  @media (max-width: 520px) {
    .inner {
      grid-template-columns: 1fr;
    }
  }
</style>
