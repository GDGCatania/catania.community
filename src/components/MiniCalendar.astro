---
import { localDayKey, eventCount } from '../lib/events';
import { localeTag } from '../i18n';
import * as m from '../paraglide/messages.js';

export interface Props {
  /** Events per day, keyed by `YYYY-MM-DD`. */
  counts: Record<string, number>;
}

const { counts } = Astro.props;

// The page is only rebuilt when the data changes, so the month the viewer is
// in may not be the build's. Every month from the build's to the last one with
// events is rendered (at least two, to cover a month boundary), and the client
// script shows the right one. Without JavaScript the build's month stays.
const now = new Date();
const todayKey = localDayKey(now);
const firstMonth = todayKey.slice(0, 7);
const lastMonth = [nextMonth(firstMonth), ...Object.keys(counts).map((key) => key.slice(0, 7))]
  .sort()
  .at(-1)!;

const months: string[] = [];
for (let month = firstMonth; month <= lastMonth; month = nextMonth(month)) months.push(month);

function nextMonth(month: string): string {
  const [year, monthNumber] = month.split('-').map(Number);
  return new Date(Date.UTC(year!, monthNumber!, 1)).toISOString().slice(0, 7);
}

const calendars = months.map((month) => {
  const [year, monthNumber] = month.split('-').map(Number);
  const first = new Date(Date.UTC(year!, monthNumber! - 1, 1));
  const daysInMonth = new Date(Date.UTC(year!, monthNumber!, 0)).getUTCDate();

  // getUTCDay(): 0 = Sunday. The week starts on Monday here.
  const leadingBlanks = (first.getUTCDay() + 6) % 7;

  const label = new Intl.DateTimeFormat(localeTag, {
    month: 'long',
    year: 'numeric',
    timeZone: 'UTC',
  }).format(first);

  const cells = [
    ...Array.from({ length: leadingBlanks }, () => null),
    ...Array.from({ length: daysInMonth }, (_, i) => {
      const day = i + 1;
      const key = `${month}-${String(day).padStart(2, '0')}`;
      return { day, key, count: counts[key] ?? 0, isToday: key === todayKey };
    }),
  ];

  const total = Object.entries(counts)
    .filter(([key]) => key.startsWith(month))
    .reduce((sum, [, count]) => sum + count, 0);

  return { month, label, cells, total };
});
---

{
  calendars.map(({ month, label, cells, total }, index) => (
    <section
      class="calendar"
      data-calendar-month={month}
      hidden={index > 0}
      aria-label={m.calendar_aria({ month: label })}
    >
      <header>
        <h3 class="month">{label.charAt(0).toUpperCase() + label.slice(1)}</h3>
        <span class="eyebrow" data-calendar-total>{eventCount(total)}</span>
        {/* Hidden until the script runs: without it only one month is shown. */}
        <nav class="nav" data-calendar-nav hidden>
          <button type="button" data-calendar-step="-1" aria-label={m.calendar_prev()}>
            <span aria-hidden="true">‹</span>
          </button>
          <button type="button" data-calendar-step="1" aria-label={m.calendar_next()}>
            <span aria-hidden="true">›</span>
          </button>
        </nav>
      </header>

      <div class="weekdays" aria-hidden="true">
        {m.calendar_weekdays().split(',').map((initial) => <span>{initial}</span>)}
      </div>

      <div class="grid">
        {
          cells.map((cell) =>
            cell === null ? (
              <span class="cell cell--blank"></span>
            ) : cell.count > 0 ? (
              <button
                type="button"
                class:list={['cell', 'cell--has', { 'cell--today': cell.isToday }]}
                data-calendar-day={cell.key}
                data-calendar-count={cell.count}
                aria-label={m.calendar_dayAria({ day: cell.day, events: eventCount(cell.count) })}
              >
                {cell.day}
                <span class="dots" aria-hidden="true">
                  {Array.from({ length: Math.min(cell.count, 3) }, () => (
                    <span class="dot"></span>
                  ))}
                </span>
              </button>
            ) : (
              <span
                class:list={['cell', { 'cell--today': cell.isToday }]}
                data-calendar-day={cell.key}
              >
                {cell.day}
              </span>
            )
          )
        }
      </div>

      <p class="legend">
        <span class="dot" aria-hidden="true"></span>
        {m.calendar_legend()}
      </p>
    </section>
  ))
}

<style>
  .calendar[hidden] {
    display: none;
  }

  .calendar {
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface-raised);
    padding: var(--space-4);
  }

  header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3);
    margin-bottom: var(--space-3);
  }

  .month {
    font-size: var(--step-0);
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  header .eyebrow {
    margin-left: auto;
  }

  .nav {
    display: flex;
    gap: var(--space-1);
  }

  .nav[hidden] {
    display: none;
  }

  .nav button {
    display: grid;
    place-items: center;
    width: 24px;
    height: 24px;
    padding: 0;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--surface);
    color: var(--ink);
    font-size: var(--step-0);
    line-height: 1;
    cursor: pointer;
  }

  .nav button:hover:not(:disabled) {
    border-color: var(--accent);
    color: var(--accent);
  }

  .nav button:disabled {
    color: var(--ink-3);
    border-color: var(--border-soft);
    cursor: default;
  }

  .weekdays,
  .grid {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 2px;
  }

  .weekdays span {
    text-align: center;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.1em;
    color: var(--ink-3);
    padding-bottom: var(--space-2);
  }

  .cell {
    position: relative;
    aspect-ratio: 1;
    display: grid;
    place-items: center;
    border: 1px solid transparent;
    border-radius: var(--radius-sm);
    background: transparent;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    font-variant-numeric: tabular-nums;
    color: var(--ink-3);
    padding: 0;
  }

  .cell--blank {
    border: 0;
  }

  .cell--has {
    color: var(--ink);
    font-weight: 700;
    border-color: var(--border);
    background: var(--surface);
    cursor: pointer;
  }

  .cell--has:not(.cell--past):hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .cell--today {
    box-shadow: inset 0 0 0 1px var(--accent);
    color: var(--accent);
  }

  /* A day with events that ended after the build: shown like any empty day. */
  .cell--past {
    color: var(--ink-3);
    font-weight: 400;
    border-color: transparent;
    background: transparent;
    cursor: default;
  }

  .cell--past .dots {
    display: none;
  }

  .dots {
    position: absolute;
    bottom: 3px;
    left: 0;
    right: 0;
    display: flex;
    justify-content: center;
    gap: 2px;
  }

  .dot {
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: var(--accent);
  }

  .legend {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-3);
    padding-top: var(--space-3);
    border-top: 1px solid var(--border-soft);
    font-size: 11px;
    color: var(--ink-3);
  }

  .legend .dot {
    width: 4px;
    height: 4px;
  }
</style>

<script>
  import { event_count } from '../paraglide/messages.js';
  import { localDayKey } from '../lib/dates';

  // Everything relative to today was computed at build time: fix it against
  // the viewer's clock. Keys are YYYY-MM-DD, so string comparison is correct.
  const todayKey = localDayKey(new Date());
  const todayMonth = todayKey.slice(0, 7);
  const calendars = [...document.querySelectorAll<HTMLElement>('[data-calendar-month]')];

  // The viewer's month, or the nearest rendered one if it falls outside.
  const shown =
    calendars.find((calendar) => calendar.dataset.calendarMonth === todayMonth) ??
    (todayMonth < (calendars[0]?.dataset.calendarMonth ?? '') ? calendars[0] : calendars.at(-1));

  for (const calendar of calendars) {
    calendar.hidden = calendar !== shown;

    let total = 0;
    for (const cell of calendar.querySelectorAll<HTMLElement>('[data-calendar-day]')) {
      const key = cell.dataset.calendarDay ?? '';
      cell.classList.toggle('cell--today', key === todayKey);

      const count = Number(cell.dataset.calendarCount ?? 0);
      if (count === 0) continue;

      // Those events are already hidden from the list: nothing to scroll to.
      if (key < todayKey) {
        cell.classList.add('cell--past');
        (cell as HTMLButtonElement).disabled = true;
      } else {
        total += count;
      }
    }

    const counter = calendar.querySelector<HTMLElement>('[data-calendar-total]');
    if (counter) counter.textContent = event_count({ count: total });
  }

  // Month navigation, from the viewer's month forward: earlier months only
  // hold events that are already over.
  const reachable = calendars.slice(Math.max(calendars.indexOf(shown!), 0));

  reachable.forEach((calendar, index) => {
    const nav = calendar.querySelector<HTMLElement>('[data-calendar-nav]');
    if (!nav || reachable.length < 2) return;
    nav.hidden = false;

    for (const button of nav.querySelectorAll<HTMLButtonElement>('[data-calendar-step]')) {
      const step = Number(button.dataset.calendarStep);
      const target = reachable[index + step];
      button.disabled = !target;
      button.addEventListener('click', () => {
        if (!target) return;
        calendar.hidden = true;
        target.hidden = false;
        // Keep the keyboard where it was; at the end of the range, fall back
        // to the other arrow.
        const same = target.querySelector<HTMLButtonElement>(`[data-calendar-step="${step}"]`);
        const other = target.querySelector<HTMLButtonElement>(`[data-calendar-step="${-step}"]`);
        (same && !same.disabled ? same : other)?.focus();
      });
    }
  });

  // Clicking a day with events scrolls to that day's heading. The calendar is
  // a navigation aid, not a hidden filter.
  for (const cell of document.querySelectorAll<HTMLButtonElement>('button[data-calendar-day]')) {
    cell.addEventListener('click', () => {
      document.dispatchEvent(
        new CustomEvent('agenda:selectday', { detail: { day: cell.dataset.calendarDay } })
      );
    });
  }
</script>
