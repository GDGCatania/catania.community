---
import BaseLayout from '../layouts/BaseLayout.astro';
import { breadcrumbJsonLd } from '../lib/jsonld';
import { CATEGORIES, AREAS } from '../lib/schema';
import * as m from '../paraglide/messages.js';
import { areaLabel, categoryLabel } from '../i18n/labels';
import { ISSUE_URLS, ROUTES } from '../lib/site';
import Message from '../components/Message.astro';
---

<BaseLayout
  title={m.submit_title()}
  description={m.submit_metaDescription()}
  jsonLd={breadcrumbJsonLd([
    { name: m.nav_events(), path: ROUTES.home },
    { name: m.submit_title(), path: ROUTES.submit },
  ])}
>
  <div class="container head">
    <h1>{m.submit_title()}</h1>
    <p class="lede">{m.submit_intro()}</p>
  </div>

  <div class="container layout">
    <form
  class="form"
  data-submit-form
  novalidate
  data-i18n={JSON.stringify({
    missing: m.submit_missing({ fields: '__f__' }),
    missingName: m.submit_missingName(),
    missingUrl: m.submit_missingUrl(),
    missingTopics: m.submit_missingTopics(),
    sending: m.submit_sending(),
    okWithLink: m.submit_okWithLink(),
    ok: m.submit_ok(),
    openIssue: m.submit_openIssue(),
    failed: m.submit_failed(),
    failedLink: m.submit_failedLink(),
  })}
>
      <fieldset>
        <legend class="eyebrow">{m.submit_sectionCommunity()}</legend>

        <label>
          <span class="label">{m.submit_fieldName()} <em>{m.submit_required()}</em></span>
          <input type="text" name="name" required maxlength="120" placeholder="Python Catania" />
        </label>

        <label>
          <span class="label">{m.submit_fieldTagline()}</span>
          <input
            type="text"
            name="tagline"
            maxlength="200"
            placeholder={m.submit_fieldTaglinePlaceholder()}
          />
        </label>

        <label>
          <span class="label">{m.submit_fieldTopics()} <em>{m.submit_required()}</em></span>
          <span class="checks">
            {
              CATEGORIES.map((category) => (
                <label class="check">
                  <input type="checkbox" name="categories" value={category} />
                  {categoryLabel[category]()}
                </label>
              ))
            }
          </span>
        </label>

        <label>
          <span class="label">{m.submit_fieldArea()}</span>
          <span class="checks">
            {
              AREAS.map((area) => (
                <label class="check">
                  <input type="radio" name="area" value={area} checked={area === 'citta'} />
                  {areaLabel[area]()}
                </label>
              ))
            }
          </span>
        </label>
      </fieldset>

      <fieldset>
        <legend class="eyebrow">{m.submit_sectionEvents()}</legend>
        <p class="help">{m.submit_eventsHelp()}</p>

        <label>
          <span class="label">{m.submit_fieldEventsUrl()} <em>{m.submit_required()}</em></span>
          <input
            type="url"
            name="eventsUrl"
            required
            placeholder="https://…"
          />
        </label>

        <label>
          <span class="label">{m.submit_fieldIcsUrl()}</span>
          <input type="url" name="icsUrl" placeholder="https://…/events.ics" />
        </label>

        <label>
          <span class="label">{m.submit_fieldContacts()}</span>
          <input type="text" name="contacts" maxlength="300" placeholder={m.submit_fieldContactsPlaceholder()} />
        </label>
      </fieldset>

      <fieldset>
        <legend class="eyebrow">{m.submit_sectionContact()}</legend>
        <label>
          <span class="label">{m.submit_fieldContact()}</span>
          <input type="text" name="contact" maxlength="200" placeholder={m.submit_fieldContactPlaceholder()} />
          <span class="help">{m.submit_contactHelp()}</span>
        </label>
      </fieldset>

      <div class="actions">
        <button class="btn btn--primary" type="submit">{m.submit_button()}</button>
        <a class="btn btn--ghost" href={ISSUE_URLS.newCommunity} rel="noopener">
          {m.submit_buttonIssue()}
        </a>
      </div>

      <p class="status" data-form-status role="status" aria-live="polite" hidden></p>

      <noscript>
        <p class="notice">
          <Message of={m.submit_noScript} links={{ issue: ISSUE_URLS.newCommunity }} />
        </p>
      </noscript>
    </form>

    <aside class="side">
      <div class="card">
        <h2>{m.submit_nextTitle()}</h2>
        <ol>
          <li>{m.submit_next1()}</li>
          <li>{m.submit_next2()}</li>
          <li>{m.submit_next3()}</li>
        </ol>
        <p class="hint">{m.submit_nextHint()}</p>
      </div>

      <div class="card">
        <h2>{m.submit_fixTitle()}</h2>
        <p class="hint">{m.submit_fixBody()}</p>
        <a class="btn btn--ghost" href={ISSUE_URLS.correction('Correzione: ')} rel="noopener">
          {m.submit_fixButton()}
        </a>
      </div>
    </aside>
  </div>
</BaseLayout>

<style>
  .head {
    padding-block: var(--space-7) var(--space-4);
  }

  .head h1 {
    font-size: var(--step-4);
    margin-bottom: var(--space-3);
  }

  .layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 320px;
    gap: var(--space-6);
    align-items: start;
    padding-block: var(--space-4) var(--space-7);
  }

  fieldset {
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface-raised);
    padding: var(--space-4);
    margin: 0 0 var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  legend {
    padding-inline: var(--space-2);
  }

  label {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .label {
    font-size: var(--step--1);
    font-weight: 600;
  }

  .label em {
    font-style: normal;
    font-weight: 400;
    color: var(--ink-3);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-left: var(--space-2);
  }

  input[type='text'],
  input[type='url'] {
    width: 100%;
    padding: var(--space-3);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-md);
    background: var(--bg);
    color: var(--ink);
    font-size: var(--step-0);
  }

  input:focus-visible {
    border-color: var(--accent);
  }

  input[aria-invalid='true'] {
    border-color: var(--accent);
    background: var(--accent-wash);
  }

  .checks {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .check {
    flex-direction: row;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--step--1);
    color: var(--ink-2);
    cursor: pointer;
  }

  .help {
    font-size: 12px;
    color: var(--ink-3);
    line-height: 1.55;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    align-items: center;
  }

  .status {
    margin-top: var(--space-4);
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-md);
    border: 1px solid var(--border-strong);
    background: var(--surface);
    font-size: var(--step--1);
  }

  .status[data-tone='ok'] {
    border-color: var(--free-border);
    background: var(--free-bg);
    color: var(--free-ink);
  }

  .status[data-tone='error'] {
    border-color: var(--accent);
    background: var(--accent-wash);
  }

  .notice {
    margin-top: var(--space-4);
    font-size: var(--step--1);
    color: var(--ink-2);
  }

  .side {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    position: sticky;
    top: 84px;
  }

  .card {
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface);
    padding: var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    align-items: flex-start;
  }

  .card h2 {
    font-size: var(--step-1);
  }

  .card ol {
    padding-left: 1.1rem;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    font-size: var(--step--1);
    color: var(--ink-2);
    line-height: 1.55;
  }

  .hint {
    font-size: 12px;
    color: var(--ink-3);
    line-height: 1.55;
  }

  @media (max-width: 900px) {
    .layout {
      grid-template-columns: 1fr;
    }
    .side {
      position: static;
    }
  }
</style>

<script>
  /**
   * The form posts to a Worker that opens the issue on the sender's behalf, so
   * no GitHub account is needed. The site stays static: this is just a fetch.
   */
  const ENDPOINT = 'https://segnala.catania.community/submit';

  const form = document.querySelector<HTMLFormElement>('[data-submit-form]');
  const status = document.querySelector<HTMLElement>('[data-form-status]');

  // Copy translated at build time, handed over as JSON on a data attribute:
  // the dictionaries never leave the build, so this script cannot import them.
  const copy: Record<string, string> = JSON.parse(form?.dataset.i18n ?? '{}');

  function show(message: string, tone: 'ok' | 'error' | 'info'): void {
    if (!status) return;
    status.hidden = false;
    status.dataset.tone = tone;
    status.textContent = message;
  }

  form?.addEventListener('submit', async (submitEvent) => {
    submitEvent.preventDefault();
    if (!form) return;

    const data = new FormData(form);
    const categories = data.getAll('categories').map(String);

    // Minimal client-side validation: the Worker revalidates everything with
    // the same Zod schema as the rest of the project. This only avoids a
    // pointless round trip.
    const name = String(data.get('name') ?? '').trim();
    const eventsUrl = String(data.get('eventsUrl') ?? '').trim();
    const missing: string[] = [];
    if (!name) missing.push(copy.missingName ?? '');
    if (!eventsUrl) missing.push(copy.missingUrl ?? '');
    if (categories.length === 0) missing.push(copy.missingTopics ?? '');

    for (const field of ['name', 'eventsUrl'] as const) {
      const input = form.elements.namedItem(field) as HTMLInputElement | null;
      input?.setAttribute('aria-invalid', String(!String(data.get(field) ?? '').trim()));
    }

    if (missing.length > 0) {
      show((copy.missing ?? '__f__').replace('__f__', missing.join(', ')), 'error');
      return;
    }

    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    if (button) button.disabled = true;
    show(copy.sending ?? '', 'info');

    try {
      const response = await fetch(ENDPOINT, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          kind: 'nuova-community',
          name,
          tagline: String(data.get('tagline') ?? '').trim(),
          categories,
          area: String(data.get('area') ?? 'citta'),
          eventsUrl,
          icsUrl: String(data.get('icsUrl') ?? '').trim(),
          contacts: String(data.get('contacts') ?? '').trim(),
          contact: String(data.get('contact') ?? '').trim(),
        }),
      });

      if (!response.ok) throw new Error(`HTTP ${response.status}`);

      const result = (await response.json()) as { issueUrl?: string };
      show(result.issueUrl ? (copy.okWithLink ?? '') : (copy.ok ?? ''), 'ok');

      if (result.issueUrl && status) {
        const link = document.createElement('a');
        link.href = result.issueUrl;
        link.rel = 'noopener';
        link.textContent = copy.openIssue ?? '';
        status.append(link);
      }

      form.reset();
    } catch {
      // The fallback is not a dead end: we send the person to GitHub with their
      // answers already filled in, so the work they did is not lost.
      const fallback = new URL('https://github.com/raffb/catania.community/issues/new');
      fallback.searchParams.set('labels', 'nuova-community');
      fallback.searchParams.set('title', `Nuova community: ${name}`);
      fallback.searchParams.set(
        'body',
        `Link agli eventi: ${eventsUrl}\nArgomenti: ${categories.join(', ')}`
      );
      show(copy.failed ?? '', 'error');
      if (status) {
        const link = document.createElement('a');
        link.href = fallback.href;
        link.rel = 'noopener';
        link.textContent = copy.failedLink ?? '';
        status.append(link);
      }
    } finally {
      if (button) button.disabled = false;
    }
  });
</script>
