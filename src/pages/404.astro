---
import BaseLayout from '../layouts/BaseLayout.astro';
import * as m from '../paraglide/messages.js';
import { ROUTES } from '../lib/site';
---

<BaseLayout
  title={m.notFound_title()}
  description={m.notFound_body().slice(0, 155)}
  noindex={true}
>
  <div class="container wrap">
    <p class="eyebrow">{m.notFound_eyebrow()}</p>
    <h1>{m.notFound_title()}</h1>
    <p class="lede">{m.notFound_body()}</p>
    <div class="actions">
      <a class="btn btn--primary" href={ROUTES.home}>{m.notFound_toEvents()}</a>
      <a class="btn btn--ghost" href={ROUTES.communities}>{m.notFound_toCommunities()}</a>
    </div>
  </div>
</BaseLayout>

<style>
  .wrap {
    padding-block: var(--space-8);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    align-items: flex-start;
  }

  .actions {
    display: flex;
    gap: var(--space-3);
    flex-wrap: wrap;
    margin-top: var(--space-2);
  }
</style>
