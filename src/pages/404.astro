---
import BaseLayout from '../layouts/BaseLayout.astro';
import { t } from '../i18n';
import { ROUTES } from '../lib/site';
---

<BaseLayout
  title={t('notFound.title')}
  description={t('notFound.body').slice(0, 155)}
  noindex={true}
>
  <div class="container wrap">
    <p class="eyebrow">{t('notFound.eyebrow')}</p>
    <h1>{t('notFound.title')}</h1>
    <p class="lede">{t('notFound.body')}</p>
    <div class="actions">
      <a class="btn btn--primary" href={ROUTES.home}>{t('notFound.toEvents')}</a>
      <a class="btn btn--ghost" href={ROUTES.communities}>{t('notFound.toCommunities')}</a>
    </div>
  </div>
</BaseLayout>

<style>
  .wrap {
    padding-block: var(--space-8);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    align-items: flex-start;
  }

  .actions {
    display: flex;
    gap: var(--space-3);
    flex-wrap: wrap;
    margin-top: var(--space-2);
  }
</style>
